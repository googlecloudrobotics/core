load("@bazel_skylib//lib:paths.bzl", "paths")
load("@rules_helm//helm:defs.bzl", "helm_package")
load("//bazel/build_rules/app_chart:cache_gcr_credentials.bzl", "cache_gcr_credentials")
load("//bazel/build_rules/app_chart:push_all.bzl", "push_all")

def _impl(ctx):
    chart_yaml = ctx.outputs.chart_yaml

    ctx.actions.expand_template(
        template = ctx.file._chart_yaml_template,
        output = chart_yaml,
        substitutions = {"${name}": ctx.attr.chart_name, "${version}": "0.0.1"},
    )

    values_yaml = ctx.outputs.values_yaml
    source_digests = []

    values_files = [ctx.file.values] + ctx.files.extra_values

    # Use awk '1' instead of cat to concatenate values files. This ensures that
    # each file ends with a newline, preventing invalid YAML if an input file
    # is missing a trailing newline.
    cmds = ["awk '1' {} > {}".format(ctx.file.values.path, values_yaml.path)]
    if ctx.files.extra_values:
        cmds.append("echo '# extra values' >> {}".format(values_yaml.path))
        cmds.append("awk '1' {} >> {}".format(
            " ".join([f.path for f in ctx.files.extra_values]),
            values_yaml.path,
        ))

    cmds.extend([
        "cat - >> {} <<EOF".format(values_yaml.path),
        "### Generated by app_chart ###",
        "images:",
    ])

    images = ctx.attr.images or {}
    for key, value in images.items():
        digest_file = key[OutputGroupInfo].digest.to_list()[0]

        # keep the leading '/' since helm charts prepend the registry without one
        cmds.append("  {nick}: /{image}@$(cat {digest})".format(
            nick = value.replace("-", "_"),
            image = value,
            digest = digest_file.path,
        ))
        source_digests.append(digest_file)
    cmds.append("EOF")

    ctx.actions.run_shell(
        outputs = [values_yaml],
        inputs = values_files + source_digests,
        command = "\n".join(cmds),
        toolchain = None,
    )

    return [DefaultInfo(
        files = depset([chart_yaml, values_yaml]),
    )]

_app_chart_backend = rule(
    implementation = _impl,
    attrs = {
        "chart_name": attr.string(
            mandatory = True,
        ),
        "values": attr.label(
            allow_single_file = True,
            doc = "Override the default values.yaml file.",
        ),
        "extra_values": attr.label_list(
            allow_empty = True,
            allow_files = True,
            default = [],
            doc = "Extra values files to append to values.yaml. " +
                  "Use this if you only want to add additional values without changing the defaults.",
        ),
        "images": attr.label_keyed_string_dict(
            allow_empty = True,
            doc = "Images referenced by the chart.",
        ),
        "_chart_yaml_template": attr.label(
            default = Label("//bazel/build_rules/app_chart:Chart.yaml.template"),
            allow_single_file = True,
        ),
    },
    outputs = {
        "chart_yaml": paths.join("%{name}", "Chart.yaml"),
        "values_yaml": paths.join("%{name}", "values.yaml"),
    },
)

def _stage_subdir_impl(ctx):
    """Copy files into a directory"""
    outs = []
    for f in ctx.files.srcs:
        out = ctx.actions.declare_file(paths.join(ctx.attr.subdir, f.basename))
        # ctx.actions.symlink doesn't work in remote build if target file is a cache hit because of a bazel bug.
        # Parent directory for a symlink only created for external repo:
        # https://github.com/bazelbuild/bazel/blob/8.8.2/src/main/java/com/google/devtools/build/lib/remote/AbstractActionInputPrefetcher.java#L808-L826.
        ctx.actions.run_shell(
            inputs = [f],
            outputs = [out],
            command = 'cp -f "$1" "$2"',
            arguments = [f.path, out.path],
            mnemonic = "CopyFile",
            toolchain = None,
        )
        outs.append(out)
    return [DefaultInfo(files = depset(outs))]

_stage_subdir = rule(
    implementation = _stage_subdir_impl,
    attrs = {
        "srcs": attr.label_list(
            allow_files = True,
        ),
        "subdir": attr.string(mandatory = True),
    },
)

def app_chart(
        name,
        values = None,
        extra_values = None,
        extra_templates = None,
        files = None,
        images = None,
        visibility = None):
    """Macro for a standard Cloud Robotics helm chart.

    This macro establishes two subrules for chart name "foo-cloud":
    - :foo-cloud.push pushes the Docker images for the chart (if relevant).
    - :foo-cloud.snippet-yaml is a snippet of YAML defining the chart, which is
      used by app() to generate an App CR containing multiple inline
      charts.

    Args:
      name: string. Must be in the format {app}-{chart}, where chart is
        robot, cloud, or cloud-per-robot.
      values: file. Override the default values.yaml file.
      extra_values: list of files. Extra values files to append to values.yaml.
        Use this if you only want to add additional values without changing the defaults.
      extra_templates: list of files. Extra files for the chart's templates/ directory.
      files: list of files. Extra non-template files for the chart's files/ directory.
      images: dict. Images referenced by the chart.
      visibility: Visibility.
    """

    _, chart = name.rsplit("-", 1)
    if name.endswith("cloud-per-robot"):
        chart = "cloud-per-robot"

    if not values:
        if chart == "cloud":
            values = Label("//bazel/build_rules/app_chart:values-cloud.yaml")
        else:
            values = Label("//bazel/build_rules/app_chart:values-robot.yaml")

    # We have a dict of string:target, but bazel rules only support target:string.
    reversed_images = {}
    if images:
        for k, v in images.items():
            reversed_images[v] = k

    _app_chart_backend(
        name = name + ".inputs",
        chart_name = name,
        values = values,
        extra_values = extra_values,
        images = reversed_images,
        visibility = visibility,
    )

    # We need to put extra files in files/ directory to keep old behavior.
    # helm_package does not prefix files so we need to prepare the correct directory structure.
    # FIXME: This will fail if multiple targets in the same directory points to different files with the same file name (bazel will complain about conflicting outputs).
    _stage_subdir(
        name = name + ".files",
        srcs = files,
        subdir = "files",
    )

    _stage_subdir(
        name = name + ".templates",
        srcs = native.glob([chart + "/*.yaml"], allow_empty = True) + (extra_templates or []),
        subdir = name + ".templates",
    )

    helm_package(
        name = name,
        chart = paths.join(name + ".inputs", "Chart.yaml"),
        values = paths.join(name + ".inputs", "values.yaml"),
        templates = [":" + name + ".templates"],
        files = [":" + name + ".files"],
        stamp = 0,
        visibility = visibility,
    )

    push_all(
        name = name + ".push-all-containers",
        images = images,
    )

    cache_gcr_credentials(
        name = name + ".push",
        target = name + ".push-all-containers",
        visibility = visibility,
    )

    native.genrule(
        name = name + ".snippet-yaml",
        srcs = [name],
        outs = [name + ".snippet.yaml"],
        cmd = """cat <<EOF > $@
    {target}:
      inline: $$(base64 -w 0 $<)
EOF
""".format(name = name, target = chart),
    )
