load("//bazel:app.bzl", "app")
load("//bazel:app_chart.bzl", "app_chart")
load("//bazel:build_rules/helm_template.bzl", "helm_template")

# --- Cloud side ---

helm_template(
    name = "victoriametrics-robotmetrics-chart.cloud",
    # Pinned to 0.11.23 (not latest) - newer versions require Helm 3.14+
    # via the shared victoria-metrics-common dependency, incompatible with
    # CRC's hermetic Helm 3.9.0 binary used by this rule.
    chart = "//third_party/victoria-metrics-cluster:victoria-metrics-cluster-0.11.23.tgz",
    helm_version = 3,
    kube_version = "1.29.0",
    namespace = "HELM-NAMESPACE",
    release_name = "vm",
    values = "victoriametrics-cloud.values.yaml",
)

helm_template(
    name = "vmalert-chart.cloud",
    # Pinned to 0.6.0 - same reasoning as vmagent's pin: predates the
    # victoria-metrics-common probe templating pattern incompatible
    # with this rule's invocation of Helm.
    chart = "//third_party/victoria-metrics-alert:victoria-metrics-alert-0.6.0.tgz",
    helm_version = 3,
    kube_version = "1.29.0",
    namespace = "HELM-NAMESPACE",
    release_name = "vm",
    values = "vmalert.cloud.values.yaml",
)

app_chart(
    name = "victoriametrics-robotmetrics-cloud",
    extra_values = ["values-cloud.yaml"],
    files = [
        ":victoriametrics-robotmetrics-chart.cloud",
        ":vmalert-chart.cloud",
    ],
    images = {},
)

# --- Robot side ---

helm_template(
    name = "vmagent-chart.robot",
    # Pinned to 0.6.0 - later versions introduce a probe templating
    # pattern using Helm's tpl function that requires Template.Basepath
    # context unavailable under this rule's invocation of Helm.
    chart = "//third_party/victoria-metrics-agent:victoria-metrics-agent-0.6.0.tgz",
    helm_version = 3,
    kube_version = "1.29.0",
    namespace = "HELM-NAMESPACE",
    release_name = "vmagent",
    values = "victoriametrics-agent.robot.values.yaml",
)

helm_template(
    name = "node-exporter-chart.robot",
    chart = "//third_party/kube-prometheus-stack:kube-prometheus-stack-87.5.1.tgz",
    helm_version = 3,
    kube_version = "1.29.0",
    namespace = "HELM-NAMESPACE",
    release_name = "node-exporter",
    values = "node-exporter.robot.values.yaml",
)

app_chart(
    name = "victoriametrics-robotmetrics-robot",
    extra_values = ["values-robot.yaml"],
    files = [
        ":node-exporter-chart.robot",
        ":vmagent-chart.robot",
    ],
)

app(
    name = "victoriametrics-robotmetrics",
    charts = [
        ":victoriametrics-robotmetrics-cloud",
        ":victoriametrics-robotmetrics-robot",
    ],
    visibility = ["//visibility:public"],
)
