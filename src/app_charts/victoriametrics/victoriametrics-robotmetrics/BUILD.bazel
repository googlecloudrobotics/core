load("//bazel:app.bzl", "app")
load("//bazel:app_chart.bzl", "app_chart")
load("//bazel:build_rules/helm_template.bzl", "helm_template")

# --- Cloud side ---

helm_template(
    name = "victoriametrics-robotmetrics-chart.cloud",
    chart = "//third_party/victoria-metrics-cluster:victoria-metrics-cluster-0.48.0.tgz",
    helm_version = 3,
    kube_version = "1.29.0",
    namespace = "HELM-NAMESPACE",
    release_name = "victoriametrics-robotmetrics",
    values = "victoriametrics-cloud.values.yaml",
)

helm_template(
    name = "vmalert-chart.cloud",
    chart = "//third_party/victoria-metrics-alert:victoria-metrics-alert-0.46.0.tgz",
    helm_version = 3,
    kube_version = "1.29.0",
    namespace = "HELM-NAMESPACE",
    release_name = "victoriametrics-robotmetrics",
    values = "vmalert.cloud.values.yaml",
)

helm_template(
    name = "vmagent-chart.cloud",
    chart = "//third_party/victoria-metrics-agent:victoria-metrics-agent-0.45.0.tgz",
    helm_version = 3,
    kube_version = "1.29.0",
    namespace = "HELM-NAMESPACE",
    release_name = "release-name-placeholder",
    values = "victoriametrics-agent.cloud.values.yaml",
)

app_chart(
    name = "victoriametrics-robotmetrics-cloud",
    extra_values = ["values-cloud.yaml"],
    files = [
        ":victoriametrics-robotmetrics-chart.cloud",
        ":vmalert-chart.cloud",
        ":vmagent-chart.cloud",
    ],
    images = {},
)

# --- Robot side ---

helm_template(
    name = "vmagent-chart.robot",
    # Pinned to 0.45.0; CRC now uses Helm 3.21.3, which supports
    # the victoria-metrics-common templates used by this chart.
    chart = "//third_party/victoria-metrics-agent:victoria-metrics-agent-0.45.0.tgz",
    helm_version = 3,
    kube_version = "1.29.0",
    namespace = "HELM-NAMESPACE",
    release_name = "victoriametrics-robotmetrics",
    values = "victoriametrics-agent.robot.values.yaml",
)

helm_template(
    name = "node-exporter-chart.robot",
    chart = "//third_party/kube-prometheus-stack:kube-prometheus-stack-87.5.1.tgz",
    helm_version = 3,
    kube_version = "1.29.0",
    namespace = "HELM-NAMESPACE",
    release_name = "node-exporter",
    values = "node-exporter.robot.values.yaml",
)

app_chart(
    name = "victoriametrics-robotmetrics-robot",
    extra_values = ["values-robot.yaml"],
    files = [
        ":node-exporter-chart.robot",
        ":vmagent-chart.robot",
    ],
)

app(
    name = "victoriametrics-robotmetrics",
    charts = [
        ":victoriametrics-robotmetrics-cloud",
        ":victoriametrics-robotmetrics-robot",
    ],
    visibility = ["//visibility:public"],
)
