load("@rules_helm//helm:defs.bzl", "helm_template")
load("//bazel:app.bzl", "app")
load("//bazel:app_chart.bzl", "app_chart")

# Robot-only app: one vmagent (vmagent-vmr) per robot. Its cloud-side counterpart
# (write route + central aggregation vmagent) lives in victoriametrics-cloudmetrics.

helm_template(
    name = "victoriametrics-robotmetrics-chart.robot",
    chart = "//src/app_charts/victoriametrics:victoriametrics-chart",
    opts = [
        "--name-template",
        "vmr",
        # The namespace will later be replaced with the actual one.
        "--namespace",
        "HELM-NAMESPACE",
        "--kube-version",
        "1.29.0",
    ],
    values = ["victoriametrics-robotmetrics-robot.values.yaml"],
)

app_chart(
    name = "victoriametrics-robotmetrics-robot",
    extra_values = ["values-robot.yaml"],
    files = [
        ":victoriametrics-robotmetrics-chart.robot",
    ],
)

app(
    name = "victoriametrics-robotmetrics",
    charts = [
        ":victoriametrics-robotmetrics-robot",
    ],
    visibility = ["//visibility:public"],
)
