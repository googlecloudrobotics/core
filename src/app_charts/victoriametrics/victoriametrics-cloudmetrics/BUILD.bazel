load("//bazel:build_rules/helm_template.bzl", "helm_template")
load("//bazel:app_chart.bzl", "app_chart")

helm_template(
    name = "victoriametrics-cloudmetrics-chart.cloud",
    chart = "//third_party/victoria-metrics-k8s-stack:victoria-metrics-k8s-stack-0.91.0.tgz",
    helm_version = 3,
    namespace = "HELM-NAMESPACE",
    release_name = "victoria-metrics-cloudmetrics",
    values = "values-cloud.yaml",
)

app_chart(
    name = "victoriametrics-cloudmetrics",
    extra_templates = [
        "cloud/victoriametrics-cloudmetrics-operator.yaml",
        "cloud/kube-state-metrics-operator.yaml",
        "cloud/victoriametrics-cloudmetrics-ingress.yaml",
    ],
    files = [
        ":victoriametrics-cloudmetrics-chart.cloud",
    ],
    extra_values = ["values-cloud.yaml"],
    images = {},
    values = "victoriametrics-cloudmetrics.values.yaml",
)
