load("@rules_helm//helm:defs.bzl", "helm_template")
load("//bazel:app.bzl", "app")
load("//bazel:app_chart.bzl", "app_chart")

helm_template(
    name = "victoriametrics-cloudmetrics-chart.cloud",
    chart = "//src/app_charts/victoriametrics:victoriametrics-chart",
    opts = [
        "--name-template",
        "vmc",
        # The namespace will later be replaced with the actual one.
        "--namespace",
        "HELM-NAMESPACE",
    ],
    values = ["victoriametrics-cloudmetrics-cloud.values.yaml"],
)

app_chart(
    name = "victoriametrics-cloudmetrics-cloud",
    extra_values = ["values-cloud.yaml"],
    files = [
        ":victoriametrics-cloudmetrics-chart.cloud",
    ],
    images = {},
)

app(
    name = "victoriametrics-cloudmetrics",
    charts = [
        ":victoriametrics-cloudmetrics-cloud",
    ],
    visibility = ["//visibility:public"],
)
