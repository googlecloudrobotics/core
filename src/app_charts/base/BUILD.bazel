load("@rules_helm//helm:defs.bzl", "helm_import", "helm_template")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:app_chart.bzl", "app_chart")

# Tests

helm_template(
    name = "chart-assignment-controller-chart.robot",
    chart = "//src/app_charts/chart-assignment-controller",
    opts = [
        "--name-template",
        "chart-assignment-controller",
        # The namespace will later be replaced with the actual one.
        "--namespace",
        "HELM-NAMESPACE",
    ],
    values = ["chart-assignment-controller-robot.values.yaml"],
)

sh_test(
    name = "app_management_test",
    srcs = ["app_management_test.sh"],
    data = [
        ":base-cloud",
        ":base-robot",
        "@helm",
    ],
)

# Robot

helm_import(
    name = "cert-manager-chart",
    chart = "//third_party/cert-manager:cert-manager-chart",
)

helm_template(
    name = "cert-manager-chart.robot",
    chart = ":cert-manager-chart",
    opts = [
        "--name-template",
        "cert-manager",
        # The namespace will later be replaced with the actual one.
        "--namespace",
        "HELM-NAMESPACE",
    ],
    values = ["cert-manager-robot.values.yaml"],
)

app_chart(
    name = "base-robot",
    extra_templates = [
        ":cloud/namespace.yaml",
        ":cloud/registry-crd.yaml",
        ":cloud/apps-crd.yaml",
        "//third_party/kube-prometheus-stack:01-crds.yaml",
    ],
    extra_values = ["values-robot.yaml"],
    files = [
        ":cert-manager-chart.robot",
        ":chart-assignment-controller-chart.robot",
        "//third_party/fluentd_gcp_addon",
    ],
    images = {
        "cr-syncer": "//src/go/cmd/cr-syncer:cr-syncer-image",
        "gcr-credential-refresher": "//src/go/cmd/gcr-credential-refresher:gcr-credential-refresher-image",
        "metadata-server": "//src/go/cmd/metadata-server:metadata-server-image",
        "chart-assignment-controller": "//src/go/cmd/chart-assignment-controller:chart-assignment-controller-image",
    },
    visibility = ["//visibility:public"],
)

# Cloud

helm_template(
    name = "cert-manager-chart.cloud",
    chart = ":cert-manager-chart",
    opts = [
        "--name-template",
        "cert-manager",
        # The namespace will later be replaced with the actual one.
        "--namespace",
        "HELM-NAMESPACE",
    ],
    values = ["cert-manager-cloud.values.yaml"],
)

helm_template(
    name = "chart-assignment-controller-chart.cloud",
    chart = "//src/app_charts/chart-assignment-controller",
    opts = [
        "--name-template",
        "chart-assignment-controller",
        # The namespace will later be replaced with the actual one.
        "--namespace",
        "HELM-NAMESPACE",
    ],
    values = ["chart-assignment-controller-cloud.values.yaml"],
)

app_chart(
    name = "base-cloud",
    extra_templates = [
        "@com_github_kubernetes_sigs_application//:app_crd",
        "//third_party/kube-prometheus-stack:01-crds.yaml",
        "//third_party/gateway-api:gatewayapi-crds.yaml",
        "//third_party/envoy-gateway:envoy-gateway-crds.yaml",
        "//third_party/envoy-gateway:envoy-gateway-generated.yaml",
    ],
    files = [
        "relay-dashboard.json",
        ":cert-manager-chart.cloud",
        ":chart-assignment-controller-chart.cloud",
        "//third_party/envoy-gateway:envoy-gateway-dashboards",
        "@ingress-nginx//:ingress-nginx-dashboards",
    ],
    images = {
        "app-rollout-controller": "//src/go/cmd/app-rollout-controller:app-rollout-controller-image",
        "chart-assignment-controller": "//src/go/cmd/chart-assignment-controller:chart-assignment-controller-image",
        "cr-syncer-auth-webhook": "//src/go/cmd/cr-syncer-auth-webhook:cr-syncer-auth-webhook-image",
        "status-echo-server": "//src/go/cmd/status-echo-server:status-echo-server-image",
    },
    values = "values-cloud.yaml",
    visibility = ["//visibility:public"],
)
